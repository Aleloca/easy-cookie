{
  "name": "@easy-cookie/policy",
  "version": "0.1.2",
  "description": "Generate the cookie policy (HTML, Markdown, React) and autoClear rules from an easy-cookie config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aleloca/easy-cookie.git",
    "directory": "packages/policy"
  },
  "bugs": {
    "url": "https://github.com/Aleloca/easy-cookie/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./legal.css": "./dist/easy-cookie-legal.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node -e \"require('fs').copyFileSync('src/legal.css','dist/easy-cookie-legal.css')\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@easy-cookie/core": "workspace:^",
    "markdown-it": "^14.3.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://consent.aleloca.dev",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "cookie-banner",
    "consent-mode"
  ]
}
