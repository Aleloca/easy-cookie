{
  "name": "@easy-cookie/posthog",
  "version": "0.1.5",
  "description": "PostHog adapter for easy-cookie: cookieless on_reject mode and opt-in/out synced with consent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aleloca/easy-cookie.git",
    "directory": "packages/posthog"
  },
  "bugs": {
    "url": "https://github.com/Aleloca/easy-cookie/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@easy-cookie/core": "workspace:^"
  },
  "peerDependencies": {
    "posthog-js": ">=1.200.0"
  },
  "peerDependenciesMeta": {
    "posthog-js": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://consent.aleloca.dev",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "cookie-banner",
    "consent-mode"
  ]
}
