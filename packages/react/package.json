{
  "name": "@easy-cookie/react",
  "version": "0.1.4",
  "description": "React bindings for easy-cookie: provider, useConsent() hook, consent-gated scripts and embeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aleloca/easy-cookie.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Aleloca/easy-cookie/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@easy-cookie/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://consent.aleloca.dev",
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "cookie-banner",
    "consent-mode"
  ]
}
