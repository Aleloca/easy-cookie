---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import CopyCode from './CopyCode.astro';
import libretto from '../lib/libretto-shiki.json';
import { copy, configSnippet, configStamp, installSnippets, registerRows, type Lang } from '../lib/landing-copy';
import { GITHUB_URL, stampDate, url } from '../lib/site';
import '../styles/landing.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const theme = libretto as any;
const docs = (slug: string) => url(`/docs/${slug}/`);
const demoSrc = url('/demo/') + (lang === 'en' ? '?lang=en' : '');
const catNames = lang === 'en'
  ? ['necessary', 'experience', 'measurement', 'marketing']
  : ['necessari', 'esperienza', 'misurazione', 'marketing'];
const [granted, denied] = lang === 'en' ? ['granted', 'denied'] : ['concesso', 'negato'];
const snippets = { ...installSnippets };
if (lang === 'en') {
  snippets.embed = snippets.embed.replace('poi Google Tag Manager', 'then Google Tag Manager');
  snippets.next = snippets.next.replace('prima di GTM', 'before GTM').replace('lang="it"', 'lang="en"');
}
const demoLabels = { ...t.log, empty: t.demoLogEmpty, lang };
---
<Base title={t.title} description={t.description} lang={lang} alternate={{ it: '/', en: '/en/' }}>
  <header class="masthead">
    <div class="masthead__inner">
      <a class="wordmark" href={url(lang === 'en' ? '/en/' : '/')}><Mark />easy-cookie</a>
      <nav aria-label={lang === 'en' ? 'Main' : 'Principale'}>
        <ul>
          <li><a href={docs('introduzione')}><span class="hide-sm">{t.nav.docs}</span><span class="show-sm">Docs</span></a></li>
          <li class="hide-sm"><a href={docs('avvio-rapido')}>{t.nav.start}</a></li>
          <li><a href={GITHUB_URL}>{t.nav.github}</a></li>
          <li><a href={url(t.nav.otherHref)} hreflang={t.nav.otherLang} lang={t.nav.otherLang}>{t.nav.other}</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="contenuto">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title">{t.h1}</h1>
        <div class="hero__aside">
          <p class="hero__lede">{t.lede}</p>
          <div class="hero__cta">
          <div class="hero__actions">
            <a class="btn" href="#demo">{t.ctaDemo}</a>
            <a class="btn btn--ghost" href={docs('avvio-rapido')}>{t.ctaStart}</a>
          </div>
          <p class="hero__terms">{t.terms}</p>
          </div>
        </div>
      </div>

      <div class="spread">
        <div class="spread__page spread__page--config">
          <p class="label spread__head"><span>{t.spreadLeft}</span><span class="stamp stamp--tilt spread__stamp">{configStamp}</span></p>
          <Code code={configSnippet} lang="ts" theme={theme} />
        </div>
        <div class="spread__page spread__page--out">
          <p class="label spread__head">{t.spreadRight}</p>
          <ol class="outputs">
            {t.outputs.map((o) => (
              <li>
                <code class="outputs__keys">{o.keys}</code>
                <div>
                  <h2 class="outputs__title">{o.title}</h2>
                  <p>{o.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section__head">
        <h2 id="demo-title">{t.demoH2}</h2>
        <p>{t.demoLede}</p>
      </div>
      <div class="demo">
        <div class="demo__stage">
          <div class="demo__bar">
            <span class="demo__addr">rivista.example</span>
            <button type="button" class="btn btn--ghost demo__reset" id="demo-reset">
              <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              {t.demoReset}
            </button>
          </div>
          <iframe id="demo-frame" class="demo__frame" src={demoSrc} title={t.demoFrameTitle} loading="lazy"></iframe>
        </div>
        <div class="demo__log" aria-labelledby="demo-log-title">
          <p class="label demo__log-title" id="demo-log-title">{t.demoLogTitle}</p>
          <ol class="log" id="demo-log" aria-live="polite">
            <li class="log__empty">{t.demoLogEmpty}</li>
          </ol>
        </div>
      </div>
      <p class="demo__note">{t.demoNote}</p>
    </section>

    <section class="section" aria-labelledby="register-title">
      <div class="section__head">
        <h2 id="register-title">{t.registerH2}</h2>
        <p>{t.registerLede}</p>
      </div>
      <figure class="passbook">
        <div class="passbook__top">
          <figcaption>{t.registerCaption}</figcaption>
          <span class="stamp stamp--tilt">{t.registerExample}</span>
        </div>
        <div class="passbook__scroll">
          <table class="ledger passbook__table">
            <thead>
              <tr>{t.registerCols.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {registerRows.map((r) => (
                <tr class={r.method === 'withdraw' ? 'is-withdraw' : undefined}>
                  <td><span class="stamp">{stampDate(r.date)} · {r.time} · rev {r.rev}</span></td>
                  <td class="mono">{r.id}</td>
                  <td class={`method method--${r.method}`}>{t.methods[r.method]}</td>
                  <td>
                    <span class="squares" role="img" aria-label={catNames.map((n, i) => `${n} ${r.cats[i] ? granted : denied}`).join(', ')}>
                      {r.cats.map((c) => <span class={c ? 'sq sq--on' : 'sq'} />)}
                    </span>
                  </td>
                  <td class="mono">{r.user}</td>
                  <td class="mono dim">{r.ip}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="passbook__legend">{t.registerLegend}</p>
      </figure>
      <ul class="points">
        {t.registerPoints.map((p) => (
          <li><h3>{p.title}</h3><p>{p.body}</p></li>
        ))}
      </ul>
      <p class="section__more"><a href={docs('registro-consensi')}>{t.registerLink}</a></p>
    </section>

    <section class="section" aria-labelledby="compliance-title">
      <div class="section__head">
        <h2 id="compliance-title">{t.complianceH2}</h2>
        <p>{t.complianceLede}</p>
      </div>
      <table class="ledger rules">
        <thead><tr>{t.complianceCols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
        <tbody>
          {t.compliance.map(([req, how]) => (
            <tr><th scope="row">{req}</th><td>{how}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="section__aside">{t.complianceNote}</p>
      <p class="section__more"><a href={docs('conformita')}>{t.complianceLink}</a></p>
    </section>

    <section class="section" aria-labelledby="compare-title">
      <div class="section__head">
        <h2 id="compare-title">{t.compareH2}</h2>
        <p>{t.compareLede}</p>
      </div>
      <div class="compare__scroll">
        <table class="ledger compare">
          <thead>
            <tr>
              <td></td>
              <th scope="col">{t.compareCols[1]}</th>
              <th scope="col" class="compare__us">{t.compareCols[2]}</th>
            </tr>
          </thead>
          <tbody>
            {t.compare.map(([k, a, b]) => (
              <tr><th scope="row">{k}</th><td>{a}</td><td class="compare__us">{b}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="section__more"><a href={docs('migrazione-iubenda')}>{t.compareLink}</a></p>
    </section>

    <section class="section" id="installa" aria-labelledby="install-title">
      <div class="section__head">
        <h2 id="install-title">{t.installH2}</h2>
        <p>{t.installLede}</p>
      </div>
      <div class="install">
        {t.install.map((i) => (
          <div class="install__item">
            <div class="install__text">
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </div>
            <Code code={snippets[i.key as keyof typeof snippets]} lang={i.lang as any} theme={theme} />
          </div>
        ))}
      </div>
      <p class="section__more"><a href={docs('avvio-rapido')}>{t.installLink}</a></p>
    </section>
  </main>

  <footer class="foot">
    <div class="foot__inner">
      <div>
        <a class="wordmark" href={url(lang === 'en' ? '/en/' : '/')}><Mark />easy-cookie</a>
        <p>{t.footer.about}</p>
        <p>{t.footer.cookies}</p>
      </div>
      <ul>
        <li><a href={docs('introduzione')}>{t.footer.docs}</a></li>
        <!-- REPLACE: GITHUB_URL in src/lib/site.ts before publishing -->
        <li><a href={GITHUB_URL}>{t.footer.repo}</a> <span class="foot__note">({t.footer.repoNote})</span></li>
        <li><a href={url(t.nav.otherHref)} hreflang={t.nav.otherLang} lang={t.nav.otherLang}>{t.nav.other}</a></li>
        <li class="foot__legal">{t.footer.legal}</li>
      </ul>
    </div>
  </footer>

  <script is:inline define:vars={{ demoLabels }}>
    (function () {
      var L = demoLabels;
      var log = document.getElementById('demo-log');
      var frame = document.getElementById('demo-frame');
      var reset = document.getElementById('demo-reset');
      if (!log || !frame) return;
      var signals = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage', 'personalization_storage'];
      var started = false;

      function el(tag, cls, text) {
        var n = document.createElement(tag);
        if (cls) n.className = cls;
        if (text != null) n.textContent = text;
        return n;
      }
      function clock() {
        var d = new Date();
        return [d.getHours(), d.getMinutes(), d.getSeconds()].map(function (v) { return String(v).padStart(2, '0'); }).join(':');
      }
      function add(title, body, kind) {
        if (!started) { log.textContent = ''; started = true; }
        var li = el('li', 'log__item' + (kind ? ' log__item--' + kind : ''));
        var head = el('div', 'log__head');
        head.appendChild(el('span', 'stamp', clock()));
        head.appendChild(el('span', 'log__title', title));
        li.appendChild(head);
        if (body) li.appendChild(body);
        log.insertBefore(li, log.firstChild);
      }
      function stateList(map) {
        var ul = el('ul', 'log__states');
        Object.keys(map).forEach(function (k) {
          var on = map[k] === true || map[k] === 'granted';
          var li = el('li');
          li.appendChild(el('span', on ? 'sq sq--on' : 'sq'));
          li.appendChild(el('span', 'mono', k));
          li.appendChild(el('span', 'log__val', typeof map[k] === 'string' ? map[k] : on ? 'true' : 'false'));
          ul.appendChild(li);
        });
        return ul;
      }
      function onDataLayer(item) {
        if (Array.isArray(item) && item[0] === 'consent') {
          var picked = {};
          signals.forEach(function (s) { if (item[2] && item[2][s]) picked[s] = item[2][s]; });
          add(item[1] === 'default' ? L.default : L.update, stateList(picked), item[1]);
        } else if (item && item.event === 'easy_cookie_update') {
          var b = el('div');
          b.appendChild(stateList(item.easyCookie.categories));
          add(L.event, b, 'event');
        }
      }
      window.addEventListener('message', function (e) {
        if (e.origin !== location.origin || !e.data || e.data.source !== 'ec-demo') return;
        var m = e.data;
        if (m.kind === 'dataLayer') onDataLayer(m.data);
        else if (m.kind === 'script') add(L.ran, el('p', 'log__text mono', m.data.category + ' · ' + m.data.service), 'script');
        else if (m.kind === 'event') {
          var type = m.data.type, d = m.data.detail;
          if (type === 'ready') {
            if (!frame.contentWindow.EasyCookie || !frame.contentWindow.EasyCookie.get())
              add(L.blocked, el('p', 'log__text mono', 'measurement · ga4, marketing · meta'), 'blocked');
          } else if (type === 'replay') {
            add(L.replay, stateList(m.data.categories), 'replay');
          } else if (d) {
            var rec = {
              consentId: d.consent.id,
              revision: d.consent.revision,
              method: d.consent.method,
              categories: m.data.categories,
              clientTimestamp: d.consent.updatedAt,
            };
            var pre = el('pre', 'log__json', JSON.stringify(rec, null, 2));
            add(L.record, pre, 'record');
          }
        }
      });
      if (reset)
        reset.addEventListener('click', function () {
          try { frame.contentWindow.EasyCookie.reset(); } catch (err) {}
          log.textContent = '';
          log.appendChild(el('li', 'log__empty', L.empty));
          started = false;
          frame.contentWindow.location.reload();
        });
    })();
  </script>
  <CopyCode lang={lang} />
</Base>
