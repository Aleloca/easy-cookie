---
import '../styles/libretto.css';
import { url } from '../lib/site';

interface Props {
  title: string;
  description: string;
  lang?: 'it' | 'en';
  alternate?: { it?: string; en?: string };
}
const { title, description, lang = 'it', alternate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e2f5a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {alternate?.it && <link rel="alternate" hreflang="it" href={new URL(url(alternate.it), Astro.site)} />}
    {alternate?.en && <link rel="alternate" hreflang="en" href={new URL(url(alternate.en), Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">{lang === 'en' ? 'Skip to content' : 'Vai al contenuto'}</a>
    <slot />
  </body>
</html>
