---
import Base from './Base.astro';
import Mark from '../components/Mark.astro';
import CopyCode from '../components/CopyCode.astro';
import { DOCS_NAV, DOCS_FLAT, DOCS_UPDATED, VERSION, GITHUB_URL, NPM_ORG_URL, stampDate, url } from '../lib/site';
import '../styles/docs.css';

interface Props {
  frontmatter: { title: string; description: string; updated?: string; status?: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const slug = path.split('/').pop() ?? '';
const index = DOCS_FLAT.findIndex((i) => i.slug === slug);
const prev = index > 0 ? DOCS_FLAT[index - 1] : null;
const next = index >= 0 && index < DOCS_FLAT.length - 1 ? DOCS_FLAT[index + 1] : null;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const updated = frontmatter.updated ?? DOCS_UPDATED;
---
<Base title={`${frontmatter.title} · easy-cookie`} description={frontmatter.description}>
  <div class="docs">
    <aside class="rail" aria-label="Documentation">
      <div class="rail__top">
        <a class="wordmark" href={url('/')}><Mark />easy-cookie</a>
      </div>
      <details class="rail__menu" open>
        <summary>
          <span>Documentation index</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </summary>
        <nav>
          {DOCS_NAV.map((group) => (
            <div class="rail__group">
              <p class="label rail__label">{group.label}</p>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={url(`/docs/${item.slug}/`)} aria-current={item.slug === slug ? 'page' : undefined}>
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
        <ul class="rail__foot">
          <li><a href={url('/')}>Project home</a></li>
          <li><a href={GITHUB_URL}>Source on GitHub</a></li>
          <li><a href={NPM_ORG_URL}>Packages on npm</a></li>
        </ul>
      </details>
    </aside>
    <script is:inline>
      // The index is a collapsible menu on narrow screens, always open on wide ones.
      (function () {
        var menu = document.querySelector('.rail__menu');
        var mq = window.matchMedia('(max-width: 900px)');
        var sync = function () { if (menu) menu.open = !mq.matches; };
        sync();
        mq.addEventListener('change', sync);
      })();
    </script>

    <div class="docs__main">
      <header class="page-head">
        <div class="page-head__inner">
          <h1>{frontmatter.title}</h1>
          <p class="page-head__lede">{frontmatter.description}</p>
          <p class="page-head__meta">
            <span class="stamp">Upd. {stampDate(updated)} · v{VERSION}</span>
            {frontmatter.status && <span class="page-head__status">{frontmatter.status}</span>}
          </p>
        </div>
      </header>

      <div class="docs__body">
        <article class="prose" id="content">
          <slot />
        </article>

        {toc.length > 1 && (
          <nav class="toc" aria-labelledby="toc-title">
            <p class="label toc__title" id="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? 'toc__sub' : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
      </div>

      <nav class="pager" aria-label="Previous and next pages">
        {prev ? (
          <a class="pager__link" href={url(`/docs/${prev.slug}/`)} rel="prev">
            <span class="label">Previous</span>
            <span class="pager__title">{prev.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a class="pager__link pager__link--next" href={url(`/docs/${next.slug}/`)} rel="next">
            <span class="label">Next</span>
            <span class="pager__title">{next.title}</span>
          </a>
        )}
      </nav>

      <footer class="docs__foot">
        <p>easy-cookie is free software under the MIT licence. This documentation is not legal advice.</p>
        <p>This site sets no profiling or analytics cookies.</p>
      </footer>
    </div>
  </div>
  <CopyCode />
</Base>
