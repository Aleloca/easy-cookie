# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easycookie

# HTTP port.
PORT=8787

# Public base URL of this server (no trailing slash). Written into the delivered
# config (`log.endpoint`) and embed.js asset URLs. An https:// URL also turns on
# the Secure flag of the admin session cookie. Empty = derived from each request.
PUBLIC_URL=http://localhost:3000

# First admin, created on boot only when there is no admin yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Built @easy-cookie/core assets served under /static. Relative paths resolve
# from apps/server. Default: ../../packages/core/dist
# STATIC_DIR=../../packages/core/dist

# Built console SPA served under /admin. Default: ../console/dist
# CONSOLE_DIR=../console/dist

# Behind a reverse proxy: read the client IP from X-Forwarded-For. Only enable
# when the proxy overwrites that header, otherwise clients can spoof it.
TRUST_PROXY=false

# Consent records per minute per IP hash per site (default 60).
# RATE_LIMIT_PER_MINUTE=60

# docker-compose only
# POSTGRES_PASSWORD=change-me
# SERVER_PORT=8787
